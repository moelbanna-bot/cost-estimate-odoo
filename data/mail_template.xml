<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_cost_estimate_approved" model="mail.template">
            <field name="name">Approved Cost Estimate</field>
            <field name="model_id" ref="project_cost_estimate.model_project_cost_estimate"/>
            <field name="subject">Cost Estimate Approved: {{ object.name }}</field>
            <field name="partner_to">{{ object.created_by.partner_id.id }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="object.created_by.name or 'User'">User</t>,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Your cost estimate
                        <strong>
                            <t t-out="object.name">Estimate</t>
                        </strong>
                        for the project
                        <strong>
                            <t t-out="object.project_id.name or ''">Project</t>
                        </strong>
                        has been
                        <span style="color:green;">
                            <strong>approved</strong>
                        </span>
                        .
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Estimated total cost:
                        <strong>
                            <t t-out="object.estimated_total_cost">$0.00</t>
                        </strong>
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Thank you,
                        <br/>
                        Approval Team
                    </p>
                </div>
            </field>
        </record>

        <record id="mail_template_cost_estimate_rejected" model="mail.template">
            <field name="name">Rejected Cost Estimate</field>
            <field name="model_id" ref="project_cost_estimate.model_project_cost_estimate"/>
            <field name="subject">Cost Estimate Rejected: {{ object.name }}</field>
            <field name="partner_to">{{ object.created_by.partner_id.id }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="object.created_by.name or 'User'">User</t>,
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Unfortunately, your cost estimate
                        <strong>
                            <t t-out="object.name">Estimate</t>
                        </strong>
                        for the project
                        <strong>
                            <t t-out="object.project_id.name or ''">Project</t>
                        </strong>
                        has been
                        <span style="color:red;">
                            <strong>rejected</strong>
                        </span>
                        .
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        If you have questions, please contact the project manager.
                    </p>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <br/>
                        Thank you,
                        <br/>
                        Approval Team
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>

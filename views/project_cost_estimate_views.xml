<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_create_project_cost_estimate" model="ir.actions.act_window">
        <field name="name">Create Project Cost Estimate</field>
        <field name="res_model">project.cost.estimate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage your project cost estimates here.
            </p>
        </field>
    </record>

    <record id="Project_cost_estimate_form_view" model="ir.ui.view">
        <field name="name">project.cost.estimate.form</field>
        <field name="model">project.cost.estimate</field>
        <field name="arch" type="xml">
            <form string="Project Cost Estimate">
                <sheet>
                    <header>
                        <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                                groups="project_cost_estimate.project_cost_estimate_group_manager"
                                invisible="state != 'draft'"
                        />
                        <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                                groups="project_cost_estimate.project_cost_estimate_group_approver"
                                invisible="state != 'submitted'"/>
                        <button name="action_reject" string="Reject" type="object" class="btn btn-danger"
                                groups="project_cost_estimate.project_cost_estimate_group_approver"
                                invisible="state != 'submitted'"/>
                        <button name="action_set_to_draft" string="Return to Draft" type="object" class="btn btn-info"
                                groups="project_cost_estimate.project_cost_estimate_group_approver"
                                invisible="state != 'rejected'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <group>
                        <field name="name" readonly="state in ['submitted', 'approved', 'rejected']"/>
                        <field name="project_id" readonly="state in ['submitted', 'approved', 'rejected']"/>
                        <field name="estimated_total_cost"/>
                        <field name="breakdown_ids" readonly="state in ['submitted', 'approved', 'rejected']"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_cost_estimate_list_view" model="ir.ui.view">
        <field name="name">project.cost.estimate.list</field>
        <field name="model">project.cost.estimate</field>
        <field name="arch" type="xml">
            <list string="Project Cost Estimates"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'"
                  decoration-info="state == 'draft'">
                <field name="name" string="Cost Estimate"/>
                <field name="project_id" string="Project"/>
                <field name="estimated_total_cost" string="Total Cost"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'draft'"
                />
                <field name="created_by" class="created-by"/>
            </list>
        </field>
    </record>

    <record id="project_cost_estimate_search_view" model="ir.ui.view">
        <field name="name">project.cost.estimate.search</field>
        <field name="model">project.cost.estimate</field>
        <field name="arch" type="xml">
            <search string="Project Cost Estimates">
                <field name="name"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <filter string="All Records" name="all_records"
                        domain="['|' , ('active' , '=' , True) , ('active' , '=' , False)] "/>
                <filter string="Group by Project" name="group_by_project" context="{'group_by':'project_id'}"/>
                <filter string="Group by State" name="group_by_state" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
</odoo>
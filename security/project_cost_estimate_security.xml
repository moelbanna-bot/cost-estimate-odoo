<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_cost_estimate_category" model="ir.module.category">
        <field name="name">Project Management</field>
    </record>

    <record id="project_cost_estimate_group_user" model="res.groups">
        <field name="name">Project Cost Estimate User</field>
        <field name="category_id" ref="project_cost_estimate_category"/>
    </record>

    <record id="project_cost_estimate_group_manager" model="res.groups">
        <field name="name">Project Cost Estimate Manager</field>
        <field name="category_id" ref="project_cost_estimate_category"/>
    </record>

    <record id="project_cost_estimate_group_approver" model="res.groups">
        <field name="name">Project Cost Estimate Approver</field>
        <field name="category_id" ref="project_cost_estimate_category"/>
    </record>

    <record id="project_cost_estimate_rule_user" model="ir.rule">
        <field name="name">Project Cost Estimate User Rule</field>
        <field name="model_id" ref="model_project_cost_estimate"/>
        <field name="groups" eval="[(4, ref('project_cost_estimate_group_user'))]"/>
        <field name="domain_force">[("create_uid" , "=" , user.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="project_cost_estimate_rule_manager" model="ir.rule">
        <field name="name">Project Cost Estimate Manager Rule</field>
        <field name="model_id" ref="model_project_cost_estimate"/>
        <field name="groups" eval="[(4, ref('project_cost_estimate_group_manager'))]"/>
        <field name="domain_force">[(1,"=",1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="project_cost_estimate_rule_approver" model="ir.rule">
        <field name="name">Project Cost Estimate Approver Rule</field>
        <field name="model_id" ref="model_project_cost_estimate"/>
        <field name="groups" eval="[(4, ref('project_cost_estimate_group_approver'))]"/>
        <field name="domain_force">[("state", "in", ["submitted", "approved", "rejected"])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>